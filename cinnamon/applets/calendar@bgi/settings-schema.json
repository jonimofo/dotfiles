{
    "layout": {
        "type": "layout",
        "pages": [
            "appearance-page",
            "panel-page"
        ],
        "appearance-page": {
            "type": "page",
            "title": "Apparence",
            "sections": [
                "text-size-section",
                "elements-section"
            ]
        },
        "text-size-section": {
            "type": "section",
            "title": "Taille du texte",
            "keys": [
                "events-text-scale",
                "days-text-scale",
                "header-text-scale",
                "event-gap"
            ]
        },
        "elements-section": {
            "type": "section",
            "title": "Éléments affichés",
            "keys": [
                "show-events",
                "show-header-clocks",
                "show-event-meta",
                "show-event-countdown",
                "show-day-marker",
                "show-day-summary",
                "show-week-numbers"
            ]
        },
        "panel-page": {
            "type": "page",
            "title": "Barre",
            "sections": [
                "date-section",
                "second-zone-section"
            ]
        },
        "date-section": {
            "type": "section",
            "title": "Date",
            "keys": [
                "use-custom-format",
                "custom-format",
                "custom-tooltip-format",
                "format-button"
            ]
        },
        "second-zone-section": {
            "type": "section",
            "title": "Second fuseau",
            "keys": [
                "show-second-zone",
                "second-zone-id",
                "second-zone-label"
            ]
        }
    },
    "events-text-scale": {
        "type": "scale",
        "default": 100,
        "min": 70,
        "max": 160,
        "step": 5,
        "units": "%",
        "digits": 0,
        "show-value": true,
        "description": "Événements"
    },
    "days-text-scale": {
        "type": "scale",
        "default": 100,
        "min": 70,
        "max": 160,
        "step": 5,
        "units": "%",
        "digits": 0,
        "show-value": true,
        "description": "Jours"
    },
    "header-text-scale": {
        "type": "scale",
        "default": 100,
        "min": 70,
        "max": 160,
        "step": 5,
        "units": "%",
        "digits": 0,
        "show-value": true,
        "description": "En-tête"
    },
    "event-gap": {
        "type": "spinbutton",
        "default": 8,
        "min": 0,
        "max": 24,
        "step": 1,
        "units": "px",
        "description": "Espace entre événements"
    },
    "show-header-clocks": {
        "type": "switch",
        "default": true,
        "description": "Horloges dans l'en-tête"
    },
    "show-event-meta": {
        "type": "switch",
        "default": true,
        "description": "Ligne de métadonnées"
    },
    "show-event-countdown": {
        "type": "switch",
        "default": true,
        "description": "Compte à rebours"
    },
    "show-day-marker": {
        "type": "switch",
        "default": true,
        "description": "Point sous les jours"
    },
    "show-day-summary": {
        "type": "switch",
        "default": true,
        "description": "Carte de résumé"
    },
    "show-events": {
        "type": "switch",
        "default": true,
        "description": "Show calendar events",
        "tooltip": "Check this to display events in the calendar."
    },
    "show-week-numbers": {
        "type": "switch",
        "default": false,
        "description": "Show week numbers in calendar",
        "tooltip": "Check this to show week numbers in the calendar."
    },
    "use-custom-format": {
        "type": "switch",
        "default": false,
        "description": "Use a custom date format",
        "tooltip": "Check this to define a custom format for the date in the calendar applet."
    },
    "custom-format": {
        "type": "entry",
        "default": "%A, %B %e, %H:%M",
        "description": "Date format",
        "dependency": "use-custom-format",
        "tooltip": "Set your custom format here."
    },
    "custom-tooltip-format": {
        "type": "entry",
        "default": "%A, %B %e, %H:%M",
        "description": "Date format for tooltip",
        "dependency": "use-custom-format",
        "tooltip": "Set your custom tooltip format here."
    },
    "format-button": {
        "type": "button",
        "description": "Show information on date format syntax",
        "dependency": "use-custom-format",
        "callback": "on_custom_format_button_pressed",
        "tooltip": "Click this button to know more about the syntax for date formats."
    },
    "show-second-zone": {
        "type": "switch",
        "default": true,
        "description": "Show a second time zone"
    },
    "second-zone-id": {
        "type": "entry",
        "default": "Asia/Ho_Chi_Minh",
        "description": "Time zone",
        "dependency": "show-second-zone"
    },
    "second-zone-label": {
        "type": "entry",
        "default": "VN",
        "description": "Label",
        "dependency": "show-second-zone"
    }
}
