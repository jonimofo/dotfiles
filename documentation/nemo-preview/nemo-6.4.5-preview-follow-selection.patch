+static gboolean
+preview_follow_selection_callback (gpointer data)
+{
+	NemoView *view = NEMO_VIEW (data);
+	GtkWidget *toplevel;
+	GList *selection;
+	gchar *uri;
+
+	view->details->preview_follow_selection_id = 0;
+
+	toplevel = gtk_widget_get_toplevel (GTK_WIDGET (view));
+	if (!GTK_IS_WINDOW (toplevel) || !gtk_widget_get_realized (toplevel)) {
+		return G_SOURCE_REMOVE;
+	}
+
+	selection = nemo_view_get_selection (view);
+	if (selection != NULL && selection->next == NULL) {
+		uri = nemo_file_get_uri (selection->data);
+		nemo_previewer_call_update_file (nemo_previewer_get_singleton (), uri,
+						 eel_gtk_get_window_xid (GTK_WINDOW (toplevel)));
+		g_free (uri);
+	}
+	nemo_file_list_free (selection);
+
+	return G_SOURCE_REMOVE;
+}
