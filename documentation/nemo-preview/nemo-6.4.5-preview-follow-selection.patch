Description: Let an open previewer follow the selection
 When the selection changes and exactly one file is selected, call
 UpdateFile on org.nemo.Preview without auto-starting it, after a short
 debounce. An already open preview then shows the newly selected file.
Author: Local build
Forwarded: no

--- nemo-6.4.5.orig/src/nemo-previewer.c
+++ nemo-6.4.5/src/nemo-previewer.c
@@ -141,6 +141,27 @@ previewer_close_ready_cb (GObject *sourc
   g_object_unref (self);
 }
 
+static void
+previewer_update_file_ready_cb (GObject *source,
+                                GAsyncResult *res,
+                                gpointer user_data)
+{
+  NemoPreviewer *self = user_data;
+  GError *error = NULL;
+
+  g_dbus_connection_call_finish (self->priv->connection,
+                                 res, &error);
+
+  /* the previewer not running is the normal case */
+  if (error != NULL) {
+    DEBUG ("Unable to call UpdateFile on NemoPreviewer: %s",
+           error->message);
+    g_error_free (error);
+  }
+
+  g_object_unref (self);
+}
+
 NemoPreviewer *
 nemo_previewer_get_singleton (void)
 {
@@ -195,3 +216,28 @@ nemo_previewer_call_close (NemoPreviewer
                           previewer_close_ready_cb,
                           g_object_ref (self));
 }
+
+void
+nemo_previewer_call_update_file (NemoPreviewer *self,
+                                 const gchar *uri,
+                                 guint xid)
+{
+  if (self->priv->connection == NULL) {
+    g_printerr ("No DBus connection available");
+    return;
+  }
+
+  /* only an already open previewer follows the selection */
+  g_dbus_connection_call (self->priv->connection,
+                          PREVIEWER_DBUS_NAME,
+                          PREVIEWER_DBUS_PATH,
+                          PREVIEWER_DBUS_IFACE,
+                          "UpdateFile",
+                          g_variant_new ("(si)", uri, xid),
+                          NULL,
+                          G_DBUS_CALL_FLAGS_NO_AUTO_START,
+                          -1,
+                          NULL,
+                          previewer_update_file_ready_cb,
+                          g_object_ref (self));
+}
