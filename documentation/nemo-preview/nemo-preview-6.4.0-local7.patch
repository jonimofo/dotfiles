+
+/*
+ * Documents (PDF, and office files converted to PDF) are shown in a plain
+ * GTK window instead of the Clutter stage: an XreaderView embedded through
+ * GtkClutter.Actor relayouts the whole stage on every pointer event and
+ * freezes as soon as the user scrolls.
+ */
+
+imports.gi.versions.Gtk = '3.0';
+const Gdk = imports.gi.Gdk;
+const Gtk = imports.gi.Gtk;
+const EvView = imports.gi.XreaderView;
+const NemoPreview = imports.gi.NemoPreview;
+
+const Gettext = imports.gettext.domain('nemo-extensions');
+const _ = Gettext.gettext;
+const Lang = imports.lang;
+
+const Constants = imports.util.constants;
+const Utils = imports.ui.utils;
+
+var DocumentWindow = new Lang.Class({
+    Name: 'DocumentWindow',
+
+    _init : function(args) {
+        this.file = args.file;
+        this._parent = NemoPreview.create_foreign_window(args.xid);
+        this._document = null;
+        this._model = null;
+        this._view = null;
+
+        this._createWindow(args.application, args.title);
+        this._createToolbar();
+        this._createContent();
+        this._showWindow();
+        this._loadDocument();
+    },
+
+    _createWindow : function(application, title) {
+        this._gtkWindow = new Gtk.Window({ type: Gtk.WindowType.TOPLEVEL,
+                                           title: title,
+                                           skipPagerHint: true,
+                                           skipTaskbarHint: true,
+                                           focusOnMap: false,
+                                           windowPosition: Gtk.WindowPosition.CENTER_ALWAYS,
+                                           application: application });
+
+        let workarea = Utils.getWorkarea(this._parent);
+        this._gtkWindow.set_default_size(
+            Math.min(Constants.DOCUMENT_WINDOW_WIDTH, workarea.width),
+            Math.round(workarea.height * Constants.SCREEN_FILL_RATIO));
+
+        this._gtkWindow.connect('key-press-event',
+                                Lang.bind(this, this._onKeyPressEvent));
+        this._gtkWindow.connect('destroy',
+                                Lang.bind(this, this._onDestroy));
+
+        this._box = new Gtk.Box({ orientation: Gtk.Orientation.VERTICAL });
+        this._gtkWindow.add(this._box);
+    },
+
+    _createToolbar : function() {
+        this._toolbar = new Gtk.Toolbar({ icon_size: Gtk.IconSize.MENU });
+        this._toolbar.set_show_arrow(false);
+
+        this._backButton = new Gtk.ToolButton({ icon_name: 'go-previous-symbolic',
+                                                sensitive: false });
+        this._backButton.connect('clicked', Lang.bind(this, function() {
+            this._view.previous_page();
+        }));
+        this._toolbar.insert(this._backButton, -1);
+
+        this._forwardButton = new Gtk.ToolButton({ icon_name: 'go-next-symbolic',
+                                                   sensitive: false });
+        this._forwardButton.connect('clicked', Lang.bind(this, function() {
+            this._view.next_page();
+        }));
+        this._toolbar.insert(this._forwardButton, -1);
+
+        this._pageLabel = new Gtk.Label({ margin_left: 10,
+                                          margin_right: 10,
+                                          xalign: 0 });
+        let labelItem = new Gtk.ToolItem();
+        labelItem.set_expand(true);
+        labelItem.add(this._pageLabel);
+        this._toolbar.insert(labelItem, -1);
+
+        this._box.pack_start(this._toolbar, false, false, 0);
+    },
+
+    _createContent : function() {
+        this._scrolledWin = new Gtk.ScrolledWindow({ hexpand: true,
+                                                     vexpand: true });
+        this._spinner = new Gtk.Spinner({ active: true,
+                                          halign: Gtk.Align.CENTER,
+                                          valign: Gtk.Align.CENTER });
+        this._scrolledWin.add(this._spinner);
+
+        this._box.pack_start(this._scrolledWin, true, true, 0);
+    },
+
+    _showWindow : function() {
+        this._gtkWindow.realize();
+        this._gtkWindow.get_window().move_to_current_desktop();
+
+        if (this._parent)
+            this._gtkWindow.get_window().set_transient_for(this._parent);
+
+        this._gtkWindow.show_all();
+    },
+
+    _loadDocument : function() {
+        this._pdfLoader = new NemoPreview.PdfLoader();
+        this._pdfLoader.connect('notify::document',
+                                Lang.bind(this, this._onDocumentLoaded));
+        this._pdfLoader.uri = this.file.get_uri();
+    },
+
+    _onDocumentLoaded : function() {
+        if (!this._gtkWindow)
+            return;
+
+        this._document = this._pdfLoader.document;
+        if (!this._document) {
+            logError(new Error('No document loaded for ' + this.file.get_uri()),
+                     'Error loading document');
+            return;
+        }
+
+        this._model = EvView.DocumentModel.new_with_document(this._document);
+        this._model.set_sizing_mode(EvView.SizingMode.FIT_WIDTH);
+        this._model.set_continuous(true);
+        this._model.connect('page-changed',
+                            Lang.bind(this, this._updatePageLabel));
+
+        this._view = EvView.View.new();
+        this._view.set_model(this._model);
+
+        this._scrolledWin.remove(this._scrolledWin.get_child());
+        this._scrolledWin.add(this._view);
+        this._view.show();
+        this._view.grab_focus();
+
+        this._updatePageLabel();
+    },
+
+    _updatePageLabel : function() {
+        let curPage = this._model.get_page();
+        let totPages = this._document.get_n_pages();
+
+        this._backButton.set_sensitive(curPage > 0);
+        this._forwardButton.set_sensitive(curPage < totPages - 1);
+        this._pageLabel.set_text(_("%d of %d").format(curPage + 1, totPages));
+    },
+
+    _onKeyPressEvent : function(widget, event) {
+        let key = event.get_keyval()[1];
+
+        if (key == Gdk.KEY_Escape ||
+            key == Gdk.KEY_space ||
+            key == Gdk.KEY_q) {
+            this.close();
+            return true;
+        }
+
+        return false;
+    },
+
+    _onDestroy : function() {
+        this._gtkWindow = null;
+
+        if (this._pdfLoader) {
+            this._pdfLoader.cleanup_document();
+            this._pdfLoader = null;
+        }
+    },
+
+    /**************************************************************************
+     ************************ public methods **********************************
+     **************************************************************************/
+    getGtkWindow : function() {
+        return this._gtkWindow;
+    },
+
+    close : function() {
+        if (this._gtkWindow)
+            this._gtkWindow.destroy();
+    }
+});
