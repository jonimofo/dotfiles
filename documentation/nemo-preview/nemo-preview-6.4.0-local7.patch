+
+/* Work area of the monitor showing the parent (Nemo) window, falling back
+ * to the primary monitor. */
+function getWorkarea(parent) {
+    let display = Gdk.Display.get_default();
+    let monitor = null;
+
+    if (parent)
+        monitor = display.get_monitor_at_window(parent);
+    if (!monitor)
+        monitor = display.get_primary_monitor() || display.get_monitor(0);
+
+    return monitor.get_workarea();
+}
